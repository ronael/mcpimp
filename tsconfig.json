{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"],
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "generated/**/*.ts", "test/**/*.ts", "worker.ts"]
}

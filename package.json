{
  "name": "personal-capability-registry-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "tsx src/local.ts",
    "sources:sync": "tsx src/cli/sources.ts",
    "generate:snapshot": "tsx scripts/build/generate-snapshot.ts",
    "build": "tsx scripts/build/generate-snapshot.ts && tsc --noEmit",
    "cf:dev": "tsx scripts/build/generate-snapshot.ts && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsx scripts/build/generate-snapshot.ts && tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.18.1"
  }
}
